---
// Polyhierarchy diagram — Option E.
//
// Story: one folder branch (rigid FS) is matched by multiple priority-ordered
// rules, and the same content ends up in multiple tag hierarchies
// (polyhierarchy). Arrows are bidirectional — the plugin syncs both ways.
//
// Three columns:
//   LEFT    FILESYSTEM — a PARA-style folder tree with one branch highlighted
//   CENTER  RULE STACK — three rule cards with priority badges, regex patterns,
//                        and bidirectional sync indicators
//   RIGHT   TAGS        — three tag hierarchies. The highlighted FS branch
//                        materializes as a leaf in each of them
//
// No emoji glyphs (consistent rendering). All SVG. Animation via CSS only.
---

<figure
  class="pd-fig"
  aria-label="A single folder branch is matched by three priority-ordered rules and appears in three different tag hierarchies simultaneously. All arrows are bidirectional — the plugin syncs both ways."
>
  <svg
    class="pd-svg"
    viewBox="0 0 1200 680"
    preserveAspectRatio="xMidYMid meet"
    role="img"
  >
    <defs>
      <!-- Icons -->
      <symbol id="pd-ico-folder" viewBox="0 0 24 24">
        <path d="M3 6.5A2.5 2.5 0 015.5 4h4.05a2 2 0 011.4.58l1.4 1.42H18.5A2.5 2.5 0 0121 8.5V17a2 2 0 01-2 2H5a2 2 0 01-2-2V6.5z"
              fill="currentColor" opacity="0.15" />
        <path d="M3 6.5A2.5 2.5 0 015.5 4h4.05a2 2 0 011.4.58l1.4 1.42H18.5A2.5 2.5 0 0121 8.5V17a2 2 0 01-2 2H5a2 2 0 01-2-2V6.5z"
              fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      </symbol>
      <symbol id="pd-ico-file" viewBox="0 0 24 24">
        <path d="M7 3h7l4 4v12a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z M14 3v4h4"
              fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      </symbol>
      <symbol id="pd-ico-hash" viewBox="0 0 24 24">
        <path d="M9 3l-1.5 18M16.5 3L15 21M4 9h17M3 15h17"
              fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </symbol>

      <!-- Glow -->
      <filter id="pd-glow-soft" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="3" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <filter id="pd-glow-strong" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="5" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>

      <!-- Arrowheads (bidirectional = both ends) -->
      <marker id="pd-arr-head" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,1 L10,5 L0,9 Z" class="pd-arr-head" />
      </marker>
      <marker id="pd-arr-tail" viewBox="0 0 10 10" refX="1" refY="5"
              markerWidth="6" markerHeight="6" orient="auto">
        <path d="M10,1 L0,5 L10,9 Z" class="pd-arr-head" />
      </marker>

      <!-- Branch → rule paths: start at branch right edge (x=290) with small vertical stagger.
           Endpoints hit rule card left edge at card center (y=165, 345, 525 for cards at y=95/275/455 with height=140). -->
      <path id="pd-path-b1" d="M 290,200 C 420,200 430,165 560,165" fill="none" />
      <path id="pd-path-b2" d="M 290,210 C 420,210 430,345 560,345" fill="none" />
      <path id="pd-path-b3" d="M 290,220 C 420,220 430,525 560,525" fill="none" />

      <!-- Rule → tag paths: from rule card right edge (x=880) to tag tree left edge (x=960). -->
      <path id="pd-path-t1" d="M 880,165 C 915,165 925,140 960,140" fill="none" />
      <path id="pd-path-t2" d="M 880,345 C 915,345 925,320 960,320" fill="none" />
      <path id="pd-path-t3" d="M 880,525 C 915,525 925,500 960,500" fill="none" />
    </defs>

    <!-- ────── Section headers ────── -->
    <text class="pd-sec-label" x="30" y="32">FILESYSTEM</text>
    <text class="pd-sec-sub"   x="30" y="50">rigid · each file has one parent folder</text>

    <text class="pd-sec-label" x="560" y="32">SYNC RULES</text>
    <text class="pd-sec-sub"   x="560" y="50">ordered by priority · bidirectional</text>

    <text class="pd-sec-label" x="1170" y="32" text-anchor="end">TAGS</text>
    <text class="pd-sec-sub"   x="1170" y="50" text-anchor="end">polyhierarchy · each file can have many tag parents</text>

    <!-- Divider lines under section headers -->
    <line class="pd-sec-divider" x1="30"   x2="300"  y1="64" y2="64" />
    <line class="pd-sec-divider" x1="560"  x2="840"  y1="64" y2="64" />
    <line class="pd-sec-divider" x1="900"  x2="1170" y1="64" y2="64" />

    <!-- ════════════════════════════ LEFT: FOLDER TREE ════════════════════════════ -->
    <g class="pd-fs">
      <!-- vault/ -->
      <g transform="translate(30, 95)">
        <rect class="pd-node pd-node-dir" width="260" height="32" rx="6" />
        <g transform="translate(10, 6)"><use href="#pd-ico-folder" width="20" height="20" class="pd-ico-dir" /></g>
        <text class="pd-node-text" x="38" y="21">vault/</text>
      </g>

      <!-- Projects/ -->
      <g transform="translate(50, 140)">
        <rect class="pd-node pd-node-dir" width="240" height="32" rx="6" />
        <g transform="translate(10, 6)"><use href="#pd-ico-folder" width="20" height="20" class="pd-ico-dir" /></g>
        <text class="pd-node-text" x="38" y="21">Projects/</text>
      </g>

      <!-- Q4-Roadmap/ ★ HIGHLIGHTED -->
      <g class="pd-branch-star" transform="translate(70, 185)">
        <rect class="pd-node pd-node-star" width="220" height="50" rx="8" />
        <g transform="translate(12, 8)"><use href="#pd-ico-folder" width="20" height="20" class="pd-ico-star" /></g>
        <text class="pd-node-star-text" x="40" y="22">Q4-Roadmap/</text>
        <text class="pd-node-star-sub"  x="40" y="40">(the branch we're tracing)</text>
      </g>

      <!-- nested files in Q4-Roadmap/ -->
      <g transform="translate(100, 250)">
        <use href="#pd-ico-file" width="15" height="15" class="pd-ico-muted" />
        <text class="pd-node-muted" x="22" y="12">kickoff.md</text>
      </g>
      <g transform="translate(100, 275)">
        <use href="#pd-ico-file" width="15" height="15" class="pd-ico-muted" />
        <text class="pd-node-muted" x="22" y="12">brief.md</text>
      </g>
      <g transform="translate(100, 300)">
        <use href="#pd-ico-file" width="15" height="15" class="pd-ico-muted" />
        <text class="pd-node-muted" x="22" y="12">notes.md</text>
      </g>

      <!-- siblings & other PARA branches (muted) -->
      <g transform="translate(50, 335)">
        <use href="#pd-ico-folder" width="18" height="18" class="pd-ico-muted" />
        <text class="pd-node-muted-lg" x="25" y="14">Launch/</text>
      </g>
      <g transform="translate(50, 365)">
        <use href="#pd-ico-folder" width="18" height="18" class="pd-ico-muted" />
        <text class="pd-node-muted-lg" x="25" y="14">Research/</text>
      </g>

      <g transform="translate(30, 410)">
        <use href="#pd-ico-folder" width="18" height="18" class="pd-ico-muted" />
        <text class="pd-node-muted-lg" x="25" y="14">Areas/</text>
      </g>
      <g transform="translate(50, 438)">
        <use href="#pd-ico-folder" width="18" height="18" class="pd-ico-muted" />
        <text class="pd-node-muted-lg" x="25" y="14">Health/</text>
      </g>
      <g transform="translate(50, 466)">
        <use href="#pd-ico-folder" width="18" height="18" class="pd-ico-muted" />
        <text class="pd-node-muted-lg" x="25" y="14">Finance/</text>
      </g>

      <g transform="translate(30, 510)">
        <use href="#pd-ico-folder" width="18" height="18" class="pd-ico-muted" />
        <text class="pd-node-muted-lg" x="25" y="14">Resources/</text>
      </g>
      <g transform="translate(30, 548)">
        <use href="#pd-ico-folder" width="18" height="18" class="pd-ico-muted" />
        <text class="pd-node-muted-lg" x="25" y="14">Archive/</text>
      </g>

      <!-- Tree connectors -->
      <g class="pd-tree-line">
        <path d="M 44,127 L 44,140 L 62,140" />
        <path d="M 64,172 L 64,185 L 80,185" />
        <path d="M 90,235 L 90,250 L 104,250 M 104,260 M 104,275 L 115,275 M 115,285 M 115,300 L 126,300" />
        <path d="M 64,217 L 64,335 L 82,335" />
        <path d="M 64,217 L 64,365 L 82,365" />
      </g>
    </g>

    <!-- ════════════════════════════ CENTER: RULE STACK ════════════════════════════ -->
    <g class="pd-rules">
      <!-- Rule card 1 -->
      <g class="pd-rule-card" transform="translate(560, 95)">
        <rect class="pd-rule-bg" width="320" height="140" rx="12" />
        <!-- Priority badge: number circle + single sub-label -->
        <circle class="pd-prio" cx="28" cy="30" r="18" />
        <text class="pd-prio-text" x="28" y="36" text-anchor="middle">1</text>
        <text class="pd-prio-sub" x="55" y="28">matches first</text>
        <text class="pd-prio-tag" x="55" y="42">priority 10</text>
        <!-- Divider -->
        <line class="pd-rule-divider" x1="14" x2="306" y1="62" y2="62" />
        <!-- Folder pattern -->
        <text class="pd-rule-label" x="20" y="82">folder</text>
        <text class="pd-rule-pattern-fs" x="72" y="82">^Projects/(.*)$</text>
        <!-- Bidirectional sync indicator, centered between folder and tag lines -->
        <g class="pd-bidi" transform="translate(72, 98)">
          <line x1="0" y1="0" x2="24" y2="0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          <path d="M 0,0 L 5,-4 M 0,0 L 5,4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M 24,0 L 19,-4 M 24,0 L 19,4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <text class="pd-bidi-label" x="32" y="3">bidirectional</text>
        </g>
        <!-- Tag pattern -->
        <text class="pd-rule-label" x="20" y="118">tag</text>
        <text class="pd-rule-pattern-tag" x="72" y="118">#projects/&#123;1&#125;</text>
        <!-- Transforms -->
        <text class="pd-rule-xform" x="20" y="134">transforms: snake_case · strip emoji</text>
      </g>

      <!-- Rule card 2 -->
      <g class="pd-rule-card" transform="translate(560, 275)">
        <rect class="pd-rule-bg" width="320" height="140" rx="12" />
        <circle class="pd-prio" cx="28" cy="30" r="18" />
        <text class="pd-prio-text" x="28" y="36" text-anchor="middle">2</text>
        <text class="pd-prio-sub" x="55" y="28">matches second</text>
        <text class="pd-prio-tag" x="55" y="42">priority 20</text>
        <line class="pd-rule-divider" x1="14" x2="306" y1="62" y2="62" />
        <text class="pd-rule-label" x="20" y="82">folder</text>
        <text class="pd-rule-pattern-fs" x="72" y="82">^Projects/Q(\d+)-(.*)$</text>
        <g class="pd-bidi" transform="translate(72, 98)">
          <line x1="0" y1="0" x2="24" y2="0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          <path d="M 0,0 L 5,-4 M 0,0 L 5,4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M 24,0 L 19,-4 M 24,0 L 19,4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <text class="pd-bidi-label" x="32" y="3">bidirectional</text>
        </g>
        <text class="pd-rule-label" x="20" y="118">tag</text>
        <text class="pd-rule-pattern-tag" x="72" y="118">#time/2024/q&#123;1&#125;/&#123;2&#125;</text>
        <text class="pd-rule-xform" x="20" y="134">transforms: snake_case</text>
      </g>

      <!-- Rule card 3 -->
      <g class="pd-rule-card" transform="translate(560, 455)">
        <rect class="pd-rule-bg" width="320" height="140" rx="12" />
        <circle class="pd-prio" cx="28" cy="30" r="18" />
        <text class="pd-prio-text" x="28" y="36" text-anchor="middle">3</text>
        <text class="pd-prio-sub" x="55" y="28">matches last</text>
        <text class="pd-prio-tag" x="55" y="42">priority 30</text>
        <line class="pd-rule-divider" x1="14" x2="306" y1="62" y2="62" />
        <text class="pd-rule-label" x="20" y="82">folder</text>
        <text class="pd-rule-pattern-fs" x="72" y="82">.*Roadmap.*</text>
        <g class="pd-bidi" transform="translate(72, 98)">
          <line x1="0" y1="0" x2="24" y2="0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          <path d="M 0,0 L 5,-4 M 0,0 L 5,4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M 24,0 L 19,-4 M 24,0 L 19,4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <text class="pd-bidi-label" x="32" y="3">bidirectional</text>
        </g>
        <text class="pd-rule-label" x="20" y="118">tag</text>
        <text class="pd-rule-pattern-tag" x="72" y="118">#topics/roadmaps/q4</text>
        <text class="pd-rule-xform" x="20" y="134">transforms: lowercase</text>
      </g>
    </g>

    <!-- Branch → rule arrows (one-directional; bidi is indicated in the rule cards) -->
    <use href="#pd-path-b1" class="pd-flow pd-flow-fs pd-flow-1"
         marker-end="url(#pd-arr-head)" />
    <use href="#pd-path-b2" class="pd-flow pd-flow-fs pd-flow-2"
         marker-end="url(#pd-arr-head)" />
    <use href="#pd-path-b3" class="pd-flow pd-flow-fs pd-flow-3"
         marker-end="url(#pd-arr-head)" />

    <!-- Rule → tag arrows (one-directional) -->
    <use href="#pd-path-t1" class="pd-flow pd-flow-tag pd-flow-1"
         marker-end="url(#pd-arr-head)" />
    <use href="#pd-path-t2" class="pd-flow pd-flow-tag pd-flow-2"
         marker-end="url(#pd-arr-head)" />
    <use href="#pd-path-t3" class="pd-flow pd-flow-tag pd-flow-3"
         marker-end="url(#pd-arr-head)" />

    <!-- ════════════════════════════ RIGHT: TAG HIERARCHIES ════════════════════════════ -->
    <g class="pd-tags">
      <!-- #projects/ -->
      <g class="pd-tag-tree" transform="translate(960, 90)">
        <rect class="pd-tag-bg" width="210" height="100" rx="10" />
        <g transform="translate(14, 12)">
          <use href="#pd-ico-hash" width="18" height="18" class="pd-ico-tag" />
          <text class="pd-tag-root" x="26" y="14">projects/</text>
        </g>
        <text class="pd-tag-leaf pd-tag-leaf-star" x="40" y="58">└ q4_roadmap  ★</text>
        <text class="pd-tag-leaf"                 x="40" y="78">├ launch</text>
        <text class="pd-tag-leaf"                 x="40" y="94">└ research</text>
      </g>

      <!-- #time/ -->
      <g class="pd-tag-tree" transform="translate(960, 260)">
        <rect class="pd-tag-bg" width="210" height="120" rx="10" />
        <g transform="translate(14, 12)">
          <use href="#pd-ico-hash" width="18" height="18" class="pd-ico-tag" />
          <text class="pd-tag-root" x="26" y="14">time/</text>
        </g>
        <text class="pd-tag-leaf"                 x="40" y="55">├ 2023/</text>
        <text class="pd-tag-leaf"                 x="40" y="75">└ 2024/</text>
        <text class="pd-tag-leaf"                 x="60" y="95">└ q4/</text>
        <text class="pd-tag-leaf pd-tag-leaf-star" x="80" y="115">└ roadmap  ★</text>
      </g>

      <!-- #topics/ -->
      <g class="pd-tag-tree" transform="translate(960, 440)">
        <rect class="pd-tag-bg" width="210" height="120" rx="10" />
        <g transform="translate(14, 12)">
          <use href="#pd-ico-hash" width="18" height="18" class="pd-ico-tag" />
          <text class="pd-tag-root" x="26" y="14">topics/</text>
        </g>
        <text class="pd-tag-leaf"                 x="40" y="55">├ roadmaps/</text>
        <text class="pd-tag-leaf pd-tag-leaf-star" x="60" y="75">└ q4  ★</text>
        <text class="pd-tag-leaf"                 x="40" y="100">└ research/</text>
        <text class="pd-tag-leaf"                 x="60" y="118">└ compliance</text>
      </g>
    </g>

    <!-- ═════════════════════════════ CAPTION ═════════════════════════════ -->
    <g class="pd-legend" transform="translate(30, 625)">
      <rect class="pd-legend-bg" width="1140" height="38" rx="8" />
      <text class="pd-legend-title" x="20" y="22">★</text>
      <text class="pd-legend-text"  x="42" y="18">One folder branch. Three priority-ordered rules match. The same content lives in three tag hierarchies.</text>
      <text class="pd-legend-text"  x="42" y="34">Every arrow is bidirectional — folder changes propagate to tags; tag changes move the file.</text>
    </g>
  </svg>
</figure>

<style>
  .pd-fig {
    margin: 2.5rem 0 2rem;
    padding: 0;
    max-width: 100%;
    overflow: hidden;
  }
  .pd-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ─── Section headers ─── */
  .pd-sec-label {
    font: 700 13px/1 'Space Grotesk', system-ui, sans-serif;
    letter-spacing: 0.18em;
    fill: var(--sl-color-white);
  }
  .pd-sec-sub {
    font: 400 11px/1 system-ui, sans-serif;
    fill: var(--sl-color-gray-3);
    letter-spacing: 0.03em;
  }
  .pd-sec-divider {
    stroke: var(--sl-color-gray-5);
    stroke-width: 1;
  }

  /* ─── Filesystem nodes ─── */
  .pd-node {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1;
  }
  .pd-node-dir { opacity: 0.85; }
  .pd-node-text {
    font: 500 14px/1 'JetBrains Mono', ui-monospace, monospace;
    fill: var(--sl-color-gray-1);
  }
  .pd-ico-dir   { color: var(--sl-color-gray-2); }
  .pd-ico-muted { color: var(--sl-color-gray-4); }
  .pd-node-muted {
    font: 400 11px/1 'JetBrains Mono', ui-monospace, monospace;
    fill: var(--sl-color-gray-4);
  }
  .pd-node-muted-lg {
    font: 500 13px/1 'JetBrains Mono', ui-monospace, monospace;
    fill: var(--sl-color-gray-3);
    opacity: 0.6;
  }
  .pd-tree-line path {
    stroke: var(--sl-color-gray-5);
    stroke-width: 1.2;
    stroke-dasharray: 2 3;
    fill: none;
  }

  /* ─── Highlighted branch (the star of the show) ─── */
  .pd-node-star {
    fill: color-mix(in srgb, var(--sl-color-accent) 18%, var(--sl-color-black));
    stroke: var(--sl-color-accent-high);
    stroke-width: 2;
    filter: url(#pd-glow-soft);
    animation: pd-pulse-highlight 3s ease-in-out infinite;
  }
  .pd-node-star-text {
    font: 700 14px/1 'JetBrains Mono', ui-monospace, monospace;
    fill: var(--sl-color-white);
  }
  .pd-node-star-sub {
    font: 400 10px/1 system-ui, sans-serif;
    fill: var(--sl-color-gray-2);
    font-style: italic;
  }
  .pd-ico-star { color: var(--sl-color-accent-high); }

  /* ─── Rule cards ─── */
  .pd-rule-bg {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.2;
  }
  .pd-prio {
    fill: var(--sl-color-accent);
    stroke: var(--sl-color-accent-high);
    stroke-width: 1.5;
    filter: url(#pd-glow-soft);
  }
  .pd-prio-text {
    font: 800 17px/1 'Space Grotesk', system-ui, sans-serif;
    fill: var(--sl-color-black);
  }
  .pd-prio-sub {
    font: 600 12px/1 'Space Grotesk', system-ui, sans-serif;
    fill: var(--sl-color-white);
    letter-spacing: 0.02em;
  }
  .pd-prio-tag {
    font: 500 10px/1 'JetBrains Mono', ui-monospace, monospace;
    fill: var(--sl-color-gray-3);
    letter-spacing: 0.03em;
  }
  .pd-rule-divider {
    stroke: var(--sl-color-gray-5);
    stroke-width: 1;
  }
  .pd-rule-label {
    font: 500 9px/1 'Space Grotesk', system-ui, sans-serif;
    letter-spacing: 0.12em;
    fill: var(--sl-color-gray-3);
    text-transform: uppercase;
  }
  .pd-rule-pattern-fs {
    font: 500 14px/1 'JetBrains Mono', ui-monospace, monospace;
    fill: var(--sl-color-gray-1);
  }
  .pd-rule-pattern-tag {
    font: 600 14px/1 'JetBrains Mono', ui-monospace, monospace;
    fill: var(--sl-color-accent-high);
  }
  .pd-rule-xform {
    font: 400 9px/1 system-ui, sans-serif;
    fill: var(--sl-color-gray-3);
    font-style: italic;
    letter-spacing: 0.02em;
  }
  .pd-bidi {
    color: var(--sl-color-accent-high);
  }
  .pd-bidi-label {
    font: 600 8px/1 'Space Grotesk', system-ui, sans-serif;
    letter-spacing: 0.1em;
    fill: var(--sl-color-gray-3);
    text-transform: uppercase;
  }

  /* ─── Flow arrows ─── */
  .pd-flow {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 6 5;
  }
  .pd-flow-fs {
    stroke: var(--sl-color-accent);
    opacity: 0.65;
    animation: pd-flow-pulse 3.4s linear infinite;
  }
  .pd-flow-tag {
    stroke: var(--sl-color-accent-high);
    opacity: 0.7;
