---
// Polyhierarchy diagram — Option E.
//
// Story: one folder branch (rigid FS) is matched by multiple priority-ordered
// rules, and the same content ends up in multiple tag hierarchies
// (polyhierarchy). Arrows are bidirectional — the plugin syncs both ways.
//
// Three columns:
//   LEFT    FILESYSTEM — a PARA-style folder tree with one branch highlighted
//   CENTER  RULE STACK — three rule cards with priority badges, regex patterns,
//                        and bidirectional sync indicators
//   RIGHT   TAGS        — three tag hierarchies. The highlighted FS branch
//                        materializes as a leaf in each of them
//
// No emoji glyphs (consistent rendering). All SVG. Animation via CSS only.
---

<figure
  class="pd-fig"
  aria-label="A single folder branch is matched by three priority-ordered rules and appears in three different tag hierarchies simultaneously. All arrows are bidirectional — the plugin syncs both ways."
>
  <svg
    class="pd-svg"
    viewBox="0 0 1200 740"
    preserveAspectRatio="xMidYMid meet"
    role="img"
  >
    <defs>
      <!-- Icons -->
      <symbol id="pd-ico-folder" viewBox="0 0 24 24">
        <path d="M3 6.5A2.5 2.5 0 015.5 4h4.05a2 2 0 011.4.58l1.4 1.42H18.5A2.5 2.5 0 0121 8.5V17a2 2 0 01-2 2H5a2 2 0 01-2-2V6.5z"
              fill="currentColor" opacity="0.15" />
        <path d="M3 6.5A2.5 2.5 0 015.5 4h4.05a2 2 0 011.4.58l1.4 1.42H18.5A2.5 2.5 0 0121 8.5V17a2 2 0 01-2 2H5a2 2 0 01-2-2V6.5z"
              fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      </symbol>
      <symbol id="pd-ico-file" viewBox="0 0 24 24">
        <path d="M7 3h7l4 4v12a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2z M14 3v4h4"
              fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      </symbol>
      <symbol id="pd-ico-hash" viewBox="0 0 24 24">
        <path d="M9 3l-1.5 18M16.5 3L15 21M4 9h17M3 15h17"
              fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </symbol>

      <!-- Glow -->
      <filter id="pd-glow-soft" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="3" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <filter id="pd-glow-strong" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="5" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>

      <!-- Arrowheads (bidirectional = both ends) -->
      <marker id="pd-arr-head" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,1 L10,5 L0,9 Z" class="pd-arr-head" />
      </marker>
      <marker id="pd-arr-tail" viewBox="0 0 10 10" refX="1" refY="5"
              markerWidth="6" markerHeight="6" orient="auto">
        <path d="M10,1 L0,5 L10,9 Z" class="pd-arr-head" />
      </marker>

      <!-- File → rule paths: from kickoff.md's right edge (x=290) to rule card left edge (x=560)
           at each card's vertical center (y=170, 370, 570 for cards at y=85/285/485, height=170). -->
      <path id="pd-path-b1" d="M 290,242 C 420,242 430,170 560,170" fill="none" />
      <path id="pd-path-b2" d="M 290,251 C 420,251 430,370 560,370" fill="none" />
      <path id="pd-path-b3" d="M 290,260 C 420,260 430,570 560,570" fill="none" />

      <!-- Rule → tag paths: from rule card right edge (x=900) to tag tree left edge (x=950).
           Tag tree centers (h=160): y=170, 370, 570 — aligns with rule card centers. -->
      <path id="pd-path-t1" d="M 900,170 L 950,170" fill="none" />
      <path id="pd-path-t2" d="M 900,370 L 950,370" fill="none" />
      <path id="pd-path-t3" d="M 900,570 L 950,570" fill="none" />
    </defs>

    <!-- ────── Section headers ────── -->
    <text class="pd-sec-label" x="30" y="32">FILESYSTEM</text>
    <text class="pd-sec-sub"   x="30" y="50">rigid · each file has one parent folder</text>

    <text class="pd-sec-label" x="560" y="32">SYNC RULES</text>
    <text class="pd-sec-sub"   x="560" y="50">ordered by priority · bidirectional</text>

    <text class="pd-sec-label" x="1170" y="32" text-anchor="end">TAGS</text>
    <text class="pd-sec-sub"   x="1170" y="50" text-anchor="end">polyhierarchy · each file can have many tag parents</text>

    <!-- Divider lines under section headers — aligned to each column's content width -->
    <line class="pd-sec-divider" x1="30"   x2="290"  y1="64" y2="64" />
    <line class="pd-sec-divider" x1="560"  x2="880"  y1="64" y2="64" />
    <line class="pd-sec-divider" x1="960"  x2="1170" y1="64" y2="64" />

    <!-- ════════════════════════════ LEFT: FOLDER TREE ════════════════════════════
         The winning rule (priority 10) places kickoff.md under Projects/.
         The other rules also match (via tags), but their destination folders
         are shown muted as "where the file would live if the other rule had
         priority" — making the priority-wins-folder mechanism concrete.
    -->
    <g class="pd-fs">
      <!-- vault/ -->
      <g transform="translate(30, 95)">
        <rect class="pd-node pd-node-dir" width="260" height="32" rx="6" />
        <g transform="translate(10, 6)"><use href="#pd-ico-folder" width="20" height="20" class="pd-ico-dir" /></g>
        <text class="pd-node-text" x="38" y="21">vault/</text>
      </g>

      <!-- Projects/ (the winning destination branch) -->
      <g transform="translate(50, 140)">
        <rect class="pd-node pd-node-dir" width="240" height="32" rx="6" />
        <g transform="translate(10, 6)"><use href="#pd-ico-folder" width="20" height="20" class="pd-ico-dir" /></g>
        <text class="pd-node-text" x="38" y="21">Projects/</text>
      </g>

      <!-- Q4-Roadmap/ (winning leaf folder) -->
      <g transform="translate(70, 185)">
        <rect class="pd-node pd-node-dir" width="220" height="32" rx="6" />
        <g transform="translate(10, 6)"><use href="#pd-ico-folder" width="20" height="20" class="pd-ico-dir" /></g>
        <text class="pd-node-text" x="38" y="21">Q4-Roadmap/</text>
        <text class="pd-node-winner-note" x="230" y="22" text-anchor="end">◄ winner</text>
      </g>

      <!-- kickoff.md ★ HIGHLIGHTED — the file lives here because Rule 1 has priority -->
      <g class="pd-branch-star" transform="translate(90, 230)">
        <rect class="pd-node pd-node-star" width="200" height="42" rx="8" />
        <g transform="translate(12, 10)"><use href="#pd-ico-file" width="18" height="18" class="pd-ico-star" /></g>
        <text class="pd-node-star-text" x="38" y="20">kickoff.md</text>
        <text class="pd-node-star-sub"  x="38" y="35">(placed by priority 10)</text>
      </g>

      <!-- Sibling files in Q4-Roadmap/ -->
      <g transform="translate(100, 290)">
        <use href="#pd-ico-file" width="14" height="14" class="pd-ico-muted" />
        <text class="pd-node-muted" x="20" y="11">brief.md</text>
      </g>
      <g transform="translate(100, 312)">
        <use href="#pd-ico-file" width="14" height="14" class="pd-ico-muted" />
        <text class="pd-node-muted" x="20" y="11">notes.md</text>
      </g>

      <!-- Alternate destination #1: Time/ (Rule 2's folder pattern — outvoted) -->
      <g class="pd-alt-dest" transform="translate(30, 360)">
        <rect class="pd-node pd-node-alt" width="260" height="32" rx="6" />
        <g transform="translate(10, 6)"><use href="#pd-ico-folder" width="20" height="20" class="pd-ico-alt" /></g>
        <text class="pd-node-alt-text" x="38" y="21">Time/2024/q4/roadmap/</text>
      </g>
      <g class="pd-alt-dest" transform="translate(100, 398)">
        <use href="#pd-ico-file" width="14" height="14" class="pd-ico-alt-file" />
        <text class="pd-node-alt-ghost" x="20" y="11">kickoff.md</text>
        <text class="pd-node-alt-caption" x="20" y="26">× would live here if Rule 2 won</text>
      </g>

      <!-- Alternate destination #2: Topics/ (Rule 3's folder pattern — outvoted) -->
      <g class="pd-alt-dest" transform="translate(30, 450)">
        <rect class="pd-node pd-node-alt" width="260" height="32" rx="6" />
        <g transform="translate(10, 6)"><use href="#pd-ico-folder" width="20" height="20" class="pd-ico-alt" /></g>
        <text class="pd-node-alt-text" x="38" y="21">Topics/roadmaps/q4/</text>
      </g>
      <g class="pd-alt-dest" transform="translate(100, 488)">
        <use href="#pd-ico-file" width="14" height="14" class="pd-ico-alt-file" />
        <text class="pd-node-alt-ghost" x="20" y="11">kickoff.md</text>
        <text class="pd-node-alt-caption" x="20" y="26">× would live here if Rule 3 won</text>
      </g>

      <!-- Other PARA peer (minimal context) -->
      <g transform="translate(30, 540)">
        <use href="#pd-ico-folder" width="18" height="18" class="pd-ico-muted" />
        <text class="pd-node-muted-lg" x="25" y="14">Archive/</text>
      </g>

      <!-- Tree connectors -->
      <g class="pd-tree-line">
        <path d="M 44,127 L 44,140 L 62,140" />
        <path d="M 64,172 L 64,185 L 80,185" />
        <path d="M 82,217 L 82,250 L 100,250" />
        <path d="M 108,272 L 108,295 L 116,295" />
        <path d="M 108,272 L 108,317 L 116,317" />
      </g>
    </g>

    <!-- ════════════════════════════ CENTER: RULE STACK ════════════════════════════ -->
    <g class="pd-rules">
      <!--
        Rule card layout (height 170, width 340)
          ── top padding: 16px ──
          y=14–46  header: priority badge + title row
            circle cx=30 cy=30 r=18
            title text baseline y=27
            subtitle baseline y=42
          y=58      header divider
          ── 18px gap ──
          y=80      folder row (baseline) · label at x=20, pattern at x=78
          y=108     bidi pill (centered horizontally, 36px wide)
          y=136     tag row (baseline)
          ── 12px gap ──
          y=156     transforms (baseline)
          ── bottom padding: 14px → box bottom y=170 ──
      -->

      <!-- Rule card 1: WINNER (priority 10) — determines where kickoff.md lives -->
      <g class="pd-rule-card pd-rule-winner" transform="translate(560, 85)">
        <rect class="pd-rule-bg pd-rule-bg-winner" width="340" height="170" rx="12" />
        <!-- Header -->
        <circle class="pd-prio pd-prio-winner" cx="30" cy="30" r="18" />
        <text class="pd-prio-text" x="30" y="36" text-anchor="middle">1</text>
        <text class="pd-prio-sub" x="60" y="27">matches first</text>
        <text class="pd-prio-tag" x="60" y="42">priority 10</text>
        <!-- Winner badge (top-right) -->
        <g class="pd-winner-badge" transform="translate(230, 16)">
          <rect width="100" height="22" rx="11" />
          <text x="50" y="15" text-anchor="middle">✓ MOVES FILE</text>
        </g>
        <line class="pd-rule-divider" x1="14" x2="326" y1="58" y2="58" />
        <!-- Folder row -->
        <text class="pd-rule-label" x="20" y="85">folder</text>
        <text class="pd-rule-pattern-fs" x="78" y="85">^Projects/(.*)$</text>
        <!-- Bidi pill -->
        <g class="pd-bidi" transform="translate(170, 110)">
          <rect class="pd-bidi-pill" x="-42" y="-10" width="84" height="20" rx="10" />
          <line x1="-18" y1="0" x2="18" y2="0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path d="M -18,0 L -12,-5 M -18,0 L -12,5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M 18,0 L 12,-5 M 18,0 L 12,5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <!-- Tag row -->
        <text class="pd-rule-label" x="20" y="140">tag</text>
        <text class="pd-rule-pattern-tag" x="78" y="140">#projects/&#123;1&#125;</text>
        <!-- Transforms -->
        <text class="pd-rule-xform" x="20" y="160">transforms: snake_case · strip emoji</text>
      </g>

      <!-- Rule card 2: tag only (outvoted) -->
      <g class="pd-rule-card" transform="translate(560, 285)">
        <rect class="pd-rule-bg" width="340" height="170" rx="12" />
        <circle class="pd-prio" cx="30" cy="30" r="18" />
        <text class="pd-prio-text" x="30" y="36" text-anchor="middle">2</text>
        <text class="pd-prio-sub" x="60" y="27">matches second</text>
        <text class="pd-prio-tag" x="60" y="42">priority 20</text>
        <g class="pd-outvoted-badge" transform="translate(234, 16)">
          <rect width="96" height="22" rx="11" />
          <text x="48" y="15" text-anchor="middle">TAG ONLY</text>
        </g>
        <line class="pd-rule-divider" x1="14" x2="326" y1="58" y2="58" />
        <text class="pd-rule-label" x="20" y="85">folder</text>
        <text class="pd-rule-pattern-fs" x="78" y="85">^Time/(.*)$</text>
        <g class="pd-bidi" transform="translate(170, 110)">
          <rect class="pd-bidi-pill" x="-42" y="-10" width="84" height="20" rx="10" />
          <line x1="-18" y1="0" x2="18" y2="0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path d="M -18,0 L -12,-5 M -18,0 L -12,5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M 18,0 L 12,-5 M 18,0 L 12,5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <text class="pd-rule-label" x="20" y="140">tag</text>
        <text class="pd-rule-pattern-tag" x="78" y="140">#time/&#123;1&#125;</text>
        <text class="pd-rule-xform" x="20" y="160">transforms: snake_case</text>
      </g>

      <!-- Rule card 3: tag only (outvoted) -->
      <g class="pd-rule-card" transform="translate(560, 485)">
        <rect class="pd-rule-bg" width="340" height="170" rx="12" />
        <circle class="pd-prio" cx="30" cy="30" r="18" />
        <text class="pd-prio-text" x="30" y="36" text-anchor="middle">3</text>
        <text class="pd-prio-sub" x="60" y="27">matches last</text>
        <text class="pd-prio-tag" x="60" y="42">priority 30</text>
        <g class="pd-outvoted-badge" transform="translate(234, 16)">
          <rect width="96" height="22" rx="11" />
          <text x="48" y="15" text-anchor="middle">TAG ONLY</text>
        </g>
        <line class="pd-rule-divider" x1="14" x2="326" y1="58" y2="58" />
        <text class="pd-rule-label" x="20" y="85">folder</text>
        <text class="pd-rule-pattern-fs" x="78" y="85">^Topics/(.*)$</text>
        <g class="pd-bidi" transform="translate(170, 110)">
          <rect class="pd-bidi-pill" x="-42" y="-10" width="84" height="20" rx="10" />
          <line x1="-18" y1="0" x2="18" y2="0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path d="M -18,0 L -12,-5 M -18,0 L -12,5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M 18,0 L 12,-5 M 18,0 L 12,5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <text class="pd-rule-label" x="20" y="140">tag</text>
        <text class="pd-rule-pattern-tag" x="78" y="140">#topics/&#123;1&#125;</text>
        <text class="pd-rule-xform" x="20" y="160">transforms: snake_case · lowercase</text>
      </g>
    </g>

    <!-- Branch → rule arrows: bidirectional — both ends have arrowheads.
         Matches the reality of the plugin: folder changes propagate to tags
         AND tag changes move the file. -->
    <use href="#pd-path-b1" class="pd-flow pd-flow-fs pd-flow-1"
         marker-start="url(#pd-arr-tail)" marker-end="url(#pd-arr-head)" />
    <use href="#pd-path-b2" class="pd-flow pd-flow-fs pd-flow-2"
         marker-start="url(#pd-arr-tail)" marker-end="url(#pd-arr-head)" />
    <use href="#pd-path-b3" class="pd-flow pd-flow-fs pd-flow-3"
         marker-start="url(#pd-arr-tail)" marker-end="url(#pd-arr-head)" />

    <!-- Rule → tag arrows: also bidirectional. -->
    <use href="#pd-path-t1" class="pd-flow pd-flow-tag pd-flow-1"
         marker-start="url(#pd-arr-tail)" marker-end="url(#pd-arr-head)" />
    <use href="#pd-path-t2" class="pd-flow pd-flow-tag pd-flow-2"
         marker-start="url(#pd-arr-tail)" marker-end="url(#pd-arr-head)" />
    <use href="#pd-path-t3" class="pd-flow pd-flow-tag pd-flow-3"
         marker-start="url(#pd-arr-tail)" marker-end="url(#pd-arr-head)" />

    <!-- ════════════════════════════ RIGHT: TAG HIERARCHIES ════════════════════════════
         Each tag tree ends in the SAME file (kickoff.md) — the polyhierarchy
         payoff. The file lives once on the filesystem, but is listed under
         three independent tag paths.

         Box: 230w × 160h, rx 10
         y=14–30   : # + top-level tag (e.g. "projects/")
         y=42      : divider
         y=66      : nested tag path (e.g. "└ q4_roadmap/")
         y=88      : ★ kickoff.md (the file we're tracing — highlighted)
         y=110     : brief.md (muted sibling)
         y=130     : notes.md (muted sibling)
         Indent: level 1 x=40, level 2 x=56, level 3 x=72
    -->
    <g class="pd-tags">
      <!-- #projects/q4_roadmap/ -->
      <g class="pd-tag-tree" transform="translate(950, 90)">
        <rect class="pd-tag-bg" width="230" height="160" rx="10" />
        <g transform="translate(14, 14)">
          <use href="#pd-ico-hash" width="18" height="18" class="pd-ico-tag" />
          <text class="pd-tag-root" x="26" y="14">projects/</text>
        </g>
        <line class="pd-tag-divider" x1="14" x2="216" y1="42" y2="42" />
        <text class="pd-tag-leaf pd-tag-nested"           x="40" y="66">└ q4_roadmap/</text>
        <text class="pd-tag-file pd-tag-leaf-star"        x="56" y="88">└ kickoff.md  ★</text>
        <text class="pd-tag-file pd-tag-file-muted"       x="56" y="110">├ brief.md</text>
        <text class="pd-tag-file pd-tag-file-muted"       x="56" y="130">└ notes.md</text>
        <text class="pd-tag-caption"                       x="14" y="151">via Rule 1 · #projects/&#123;1&#125;</text>
      </g>

      <!-- #time/2024/q4/roadmap/ -->
      <g class="pd-tag-tree" transform="translate(950, 290)">
        <rect class="pd-tag-bg" width="230" height="160" rx="10" />
        <g transform="translate(14, 14)">
          <use href="#pd-ico-hash" width="18" height="18" class="pd-ico-tag" />
          <text class="pd-tag-root" x="26" y="14">time/</text>
        </g>
        <line class="pd-tag-divider" x1="14" x2="216" y1="42" y2="42" />
        <text class="pd-tag-leaf pd-tag-nested"           x="40" y="66">└ 2024/q4/roadmap/</text>
        <text class="pd-tag-file pd-tag-leaf-star"        x="56" y="88">└ kickoff.md  ★</text>
        <text class="pd-tag-file pd-tag-file-muted"       x="56" y="110">├ brief.md</text>
        <text class="pd-tag-file pd-tag-file-muted"       x="56" y="130">└ notes.md</text>
        <text class="pd-tag-caption"                       x="14" y="151">via Rule 2 · #time/&#123;1&#125;</text>
      </g>

      <!-- #topics/roadmaps/q4/ -->
      <g class="pd-tag-tree" transform="translate(950, 490)">
        <rect class="pd-tag-bg" width="230" height="160" rx="10" />
        <g transform="translate(14, 14)">
          <use href="#pd-ico-hash" width="18" height="18" class="pd-ico-tag" />
          <text class="pd-tag-root" x="26" y="14">topics/</text>
        </g>
        <line class="pd-tag-divider" x1="14" x2="216" y1="42" y2="42" />
        <text class="pd-tag-leaf pd-tag-nested"           x="40" y="66">└ roadmaps/q4/</text>
        <text class="pd-tag-file pd-tag-leaf-star"        x="56" y="88">└ kickoff.md  ★</text>
        <text class="pd-tag-file pd-tag-file-muted"       x="56" y="110">├ brief.md</text>
        <text class="pd-tag-file pd-tag-file-muted"       x="56" y="130">└ notes.md</text>
        <text class="pd-tag-caption"                       x="14" y="151">via Rule 3 · #topics/&#123;1&#125;</text>
      </g>
    </g>

    <!-- ═════════════════════════════ CAPTION ═════════════════════════════ -->
    <g class="pd-legend" transform="translate(30, 680)">
      <rect class="pd-legend-bg" width="1140" height="46" rx="8" />
      <text class="pd-legend-title" x="20" y="26">★</text>
      <text class="pd-legend-text"  x="42" y="22">One folder branch. Three priority-ordered rules match. The same content lives in three tag hierarchies.</text>
      <text class="pd-legend-text"  x="42" y="38">Every arrow is bidirectional — folder changes propagate to tags; tag changes move the file.</text>
    </g>
  </svg>
</figure>

<style>
  .pd-fig {
    margin: 2.5rem 0 2rem;
    padding: 0;
    max-width: 100%;
    overflow: hidden;
  }
  .pd-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ─── Section headers ─── */
  .pd-sec-label {
    font: 700 13px/1 'Space Grotesk', system-ui, sans-serif;
    letter-spacing: 0.18em;
    fill: var(--sl-color-white);
  }
  .pd-sec-sub {
    font: 400 11px/1 system-ui, sans-serif;
    fill: var(--sl-color-gray-3);
    letter-spacing: 0.03em;
  }
  .pd-sec-divider {
    stroke: var(--sl-color-gray-5);
    stroke-width: 1;
  }

  /* ─── Filesystem nodes ─── */
  .pd-node {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1;
  }
  .pd-node-dir { opacity: 0.85; }
  .pd-node-text {
    font: 500 14px/1 'JetBrains Mono', ui-monospace, monospace;
    fill: var(--sl-color-gray-1);
  }
