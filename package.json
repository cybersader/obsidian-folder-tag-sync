{
  "name": "obsidian-dynamic-tags-folders",
  "version": "0.1.0",
  "description": "Bidirectional mapping between folder paths and tags using regex patterns and transformation rules",
  "main": "main.js",
  "scripts": {
    "dev": "bun run esbuild.config.mjs",
    "build": "bun run packs:manifest && bun x tsc -noEmit -skipLibCheck && bun run esbuild.config.mjs production",
    "packs:manifest": "node scripts/build-rule-pack-manifest.mjs",
    "version": "bun run version-bump.mjs && git add manifest.json versions.json",
    "test": "bun test src",
    "test:watch": "bun test --watch src",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "test:e2e:setup": "obsidian-launcher download --cache .obsidian-cache",
    "lint": "eslint src"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tags",
    "folders",
    "organization",
    "automation"
  ],
  "author": "cybersader",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@typescript-eslint/utils": "^8.48.1",
    "@wdio/cli": "^9.27.0",
    "@wdio/globals": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "builtin-modules": "^3.3.0",
    "chai": "^5.3.3",
    "esbuild": "^0.19.8",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "mocha": "^10.8.2",
    "obsidian": "latest",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2",
    "wdio-obsidian-reporter": "^3.0.2",
    "wdio-obsidian-service": "^3.0.2"
  }
}
