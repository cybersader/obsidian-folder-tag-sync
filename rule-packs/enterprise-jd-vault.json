{
	"id": "enterprise-jd-vault",
	"name": "Enterprise JD vault (single-digit JD + framework folders)",
	"description": "Template-shaped pack matching a generic enterprise knowledge vault with single-digit JD-style numbered roots (0 - Tasks/, 1 - Workspaces/, ... 7 - Vault Config/), 99 - ARCHIVE, and control-framework folders (CISv8/, CRI/). All rules ship disabled — review and enable.",
	"version": "1.0.0",
	"author": "Cybersader",

	"axes": ["work", "system", "capture"],
	"compatibleWith": [],
	"exclusiveWith": [],

	"detection": {
		"anyOf": [
			{ "folderRegex": "^0 - Tasks", "scope": "name", "label": "0 - Tasks, Planning" },
			{ "folderRegex": "^1 - Workspaces", "scope": "name", "label": "1 - Workspaces, Projects" },
			{ "folderRegex": "^2 - Areas", "scope": "name", "label": "2 - Areas, Initiatives" },
			{ "folderRegex": "^3 - Docs", "scope": "name", "label": "3 - Docs, Intel, SOPs" },
			{ "folderRegex": "^4 - Topics", "scope": "name", "label": "4 - Topics, Knowledge" },
			{ "folderRegex": "^5 - Archive", "scope": "name", "label": "5 - Archive, Admin" },
			{ "folderRegex": "^6 - Ideation", "scope": "name", "label": "6 - Ideation, Sandbox" },
			{ "folderRegex": "^7 - Vault Config", "scope": "name", "label": "7 - Vault Config & Management" },
			{ "folderRegex": "^99 - ARCHIVE", "scope": "name", "label": "99 - ARCHIVE" },
			{ "folderRegex": "^CISv8$", "scope": "name", "label": "CISv8 framework folder" },
			{ "folderRegex": "^CRI$", "scope": "name", "label": "CRI framework folder" }
		],
		"minSignals": 4,
		"scopedUnder": null
	},

	"rules": [
		{
			"id": "ent-tasks-planning",
			"name": "0 - Tasks, Planning",
			"description": "0 - Tasks, Planning/{deeper...} ↔ #0-tasks-planning/{deeper...}",
			"enabled": false,
			"priority": 10,
			"direction": "bidirectional",
			"folderTemplate": "0 - Tasks, Planning/{deeper...}",
			"tagTemplate": "#0-tasks-planning/{deeper...}",
			"options": {
				"createFolders": true,
				"addTags": true,
				"removeOrphanedTags": false,
				"syncOnFileCreate": true,
				"syncOnFileMove": true,
				"syncOnFileRename": true,
				"onConflict": "prompt"
			}
		},
		{
			"id": "ent-workspaces-projects",
			"name": "1 - Workspaces, Projects",
			"description": "1 - Workspaces, Projects/{deeper...} ↔ #1-workspaces-projects/{deeper...}",
			"enabled": false,
			"priority": 11,
			"direction": "bidirectional",
			"folderTemplate": "1 - Workspaces, Projects/{deeper...}",
			"tagTemplate": "#1-workspaces-projects/{deeper...}",
			"options": {
				"createFolders": true,
				"addTags": true,
				"removeOrphanedTags": false,
				"syncOnFileCreate": true,
				"syncOnFileMove": true,
