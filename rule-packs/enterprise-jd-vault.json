			"enabled": false,
			"priority": 15,
			"direction": "bidirectional",
			"folderTemplate": "5 - Archive, Admin/{deeper...}",
			"tagTemplate": "#5-archive-admin/{deeper...}",
			"options": {
				"createFolders": true,
				"addTags": true,
				"removeOrphanedTags": false,
				"syncOnFileCreate": true,
				"syncOnFileMove": true,
				"syncOnFileRename": true,
