			"name": "CRI framework",
			"description": "CRI/{function}/{deeper...} ↔ #cri/{function}/{deeper...} — CRI Profile (DE/EX/GV/ID/PR/RC/RS)",
			"enabled": false,
			"priority": 21,
			"direction": "bidirectional",
			"folderTemplate": "CRI/{function}/{deeper...}",
			"tagTemplate": "#cri/{function}/{deeper...}",
			"options": {
				"createFolders": true,
				"addTags": true,
				"removeOrphanedTags": false,
				"syncOnFileCreate": true,
