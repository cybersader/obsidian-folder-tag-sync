{
	"id": "jd",
	"name": "Johnny Decimal",
	"description": "Numeric two-digit prefixes per sibling at each depth. Each numbered area maps identity-style to tags, preserving the prefix.",
	"version": "1.0.0",
	"author": "Cybersader",

	"axes": ["work"],
	"compatibleWith": ["seacow-outer"],
	"exclusiveWith": [],

	"detection": {
		"anyOf": [
			{ "folderRegex": "^\\d{2} - [A-Za-z]", "scope": "name", "label": "Numbered area (e.g. '10 - Projects')" },
			{ "folderRegex": "^\\d{2}-[a-z]", "scope": "name", "label": "Numbered area (compact, e.g. '10-projects')" }
		],
		"minSignals": 2,
		"scopedUnder": null
	},

	"establish": {
		"createFolders": ["10 - Projects/", "20 - Areas/", "30 - Resources/", "90 - Archive/"],
		"summary": "Numbered top-level areas (10-, 20-, …, 90-). Each area can subdivide further with two-digit numeric prefixes."
	},

	"rules": [
		{
			"id": "jd-numbered-area",
			"name": "JD: any numbered area",
			"description": "Any folder matching '^NN - Name/...' identity-syncs to a tag preserving the numeric prefix",
			"enabled": true,
			"priority": 10,
			"direction": "bidirectional",
			"folderPattern": "^\\d{2} - [^/]+(?:/|$)",
			"folderEntryPoint": "",
			"folderTransforms": { "caseTransform": "Title Case", "numberPrefixHandling": "keep" },
			"tagPattern": "^\\d{2}-[a-z0-9-]+",
			"tagEntryPoint": "",
			"tagTransforms": { "caseTransform": "kebab-case", "numberPrefixHandling": "keep" },
			"options": {
				"createFolders": true, "addTags": true, "removeOrphanedTags": false,
				"syncOnFileCreate": true, "syncOnFileMove": true, "syncOnFileRename": true,
				"keepDestinationTag": true, "keepRelationTags": true, "moveAttachments": true
			}
		}
	]
}
