{
	"id": "jd",
	"name": "Johnny Decimal",
	"description": "Numeric prefixes per sibling at each depth (one or two digits). Each numbered area maps identity-style to tags, preserving the prefix.",
	"version": "1.1.0",
	"author": "Cybersader",

	"axes": ["work"],
	"compatibleWith": ["seacow-outer"],
	"exclusiveWith": [],

	"detection": {
		"anyOf": [
			{ "folderRegex": "^\\d{1,2} - [A-Za-z]", "scope": "name", "label": "Numbered area (e.g. '10 - Projects' or '0 - Tasks')", "role": "numbered-folder" },
			{ "folderRegex": "^\\d{1,2}-[a-z]", "scope": "name", "label": "Numbered area (compact, e.g. '10-projects' or '0-tasks')", "role": "numbered-folder" }
		],
		"minSignals": 2,
		"occurrence": { "countBy": "folders", "minEvidence": 2 },
		"scopedUnder": null,
		"scopedUnderMode": "local"
	},

	"establish": {
		"createFolders": ["10 - Projects/", "20 - Areas/", "30 - Resources/", "90 - Archive/"],
		"summary": "Numbered top-level areas. Strict 2-digit and enterprise-style 1-digit both supported."
	},

	"rules": [
		{
			"id": "jd-numbered-area",
			"name": "JD: any numbered area",
			"description": "Any folder matching '^N(N) - Name/...' identity-syncs to a tag preserving the numeric prefix",
			"enabled": true,
			"priority": 10,
			"direction": "bidirectional",
			"folderPattern": "^\\d{1,2} - [^/]+(?:/|$)",
			"folderEntryPoint": "",
			"folderTransforms": { "caseTransform": "Title Case", "numberPrefixHandling": "keep" },
			"tagPattern": "^\\d{1,2}-[a-z0-9-]+",
			"tagEntryPoint": "",
			"tagTransforms": { "caseTransform": "kebab-case", "numberPrefixHandling": "keep" },
			"options": {
				"createFolders": true, "addTags": true, "removeOrphanedTags": false,
				"syncOnFileCreate": true, "syncOnFileMove": true, "syncOnFileRename": true,
				"keepDestinationTag": true, "keepRelationTags": true, "moveAttachments": true
			}
		}
	]
}
